---
---
{% comment %}
  FILE: site.webmanifest
  PURPOSE: Web app manifest -- lets phones/desktops "install" the site with a proper
  name and icon (Add to Home Screen). Linked from _includes/head.html.
  Icons live in assets/img/, made from the school logo (school-logo-original.png). Three files, each for
  a different job:
    - icon-192.png / icon-512.png : normal icons ("any")
    - icon-maskable-512.png       : full-bleed version Android can crop to a circle or
                                    rounded square without cutting anything important
  theme_color falls back to the navbar colour if mobile-theme-col isn't set in _config.yml.
{% endcomment %}
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "{{ site.mobile-theme-col | default: site.navbar-col }}",
  "icons": [
    { "src": "{{ '/assets/img/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/assets/img/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/assets/img/icon-maskable-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
