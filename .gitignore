# ==============================================================================
# .gitignore Configuration
# Description: Prevents build artifacts, temporary cache files, system metadata,
#              and local environment dependencies from being committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Jekyll & Build Output Directory
# Generated site files and build caches should never be tracked in source control.
# ------------------------------------------------------------------------------
_site/          # Compiled static web pages generated by Jekyll ('jekyll build')
.sass-cache/    # Temporary cache generated during SCSS/SASS compilation
.jekyll-cache/  # Internal cache generated by Jekyll 4+ builds
.jekyll-metadata# Metadata file tracking incremental Jekyll updates

# ------------------------------------------------------------------------------
# Virtual Environments & Containers
# Local virtual machine files for isolated testing environments.
# ------------------------------------------------------------------------------
.vagrant/       # Local state and metadata generated by Vagrant VM environments

# ------------------------------------------------------------------------------
# System-Specific Metadata Files
# Hidden desktop metadata files created automatically by OS file managers.
# ------------------------------------------------------------------------------
.DS_Store       # macOS Finder folder custom display settings
.AppleDouble    # macOS AppleDouble resource forks
.LSOverride     # macOS folder overrides
Thumbs.db       # Windows Explorer thumbnail cache
ehthumbs.db     # Windows Media Center thumbnail cache

# ------------------------------------------------------------------------------
# Ruby & Dependency Locks / Gems
# Local compiled gem packages and lockfiles (if excluding vendor setups).
# ------------------------------------------------------------------------------
Gemfile.lock               # Bundler lockfile (exclude if building via GitHub Pages action or non-repo deployment)
beautiful-jekyll-theme-*.gem # Built RubyGem archive packages generated locally

# ------------------------------------------------------------------------------
# IDE & Code Editor Files
# Personal developer settings and workplace configuration folders.
# ------------------------------------------------------------------------------
.vscode/        # Visual Studio Code project settings
.idea/          # JetBrains IDE (RubyMine, IntelliJ, WebStorm) project files
*.swp           # Vim temporary swap files
*.swo           # Vim temporary swap files

